@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/*
 * PromptUI Studio design system — dark-first developer studio.
 * Ink black canvas, graphite panels, electric lime accent, cyan secondary.
 * All colors are oklch tokens. Never hardcode colors in components.
 */

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-panel: var(--panel);
  --color-panel-foreground: var(--panel-foreground);
  --color-elevated: var(--elevated);
  --color-code: var(--code-bg);
  --color-syntax-tag: var(--syntax-tag);
  --color-syntax-attr: var(--syntax-attr);
  --color-syntax-string: var(--syntax-string);
  --color-syntax-keyword: var(--syntax-keyword);
  --color-syntax-comment: var(--syntax-comment);
  --font-sans: "Inter Tight", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  --shadow-glow: 0 0 0 1px var(--ring), 0 12px 40px -12px oklch(0.65 0.22 285 / 0.35);
  --shadow-panel: 0 20px 60px -30px oklch(0 0 0 / 0.9);
}

:root {
  --radius: 0.75rem;
  --background: oklch(0.16 0.008 260);
  --foreground: oklch(0.95 0.005 260);
  --panel: oklch(0.2 0.01 260);
  --panel-foreground: oklch(0.94 0.005 260);
  --elevated: oklch(0.24 0.012 260);
  --card: oklch(0.2 0.01 260);
  --card-foreground: oklch(0.95 0.005 260);
  --popover: oklch(0.21 0.012 260);
  --popover-foreground: oklch(0.95 0.005 260);
  --primary: oklch(0.65 0.22 285);
  --primary-foreground: oklch(0.98 0.005 285);
  --secondary: oklch(0.26 0.014 260);
  --secondary-foreground: oklch(0.93 0.005 260);
  --muted: oklch(0.25 0.012 260);
  --muted-foreground: oklch(0.68 0.015 260);
  --accent: oklch(0.70 0.18 290);
  --accent-foreground: oklch(0.98 0.005 285);
  --destructive: oklch(0.62 0.21 25);
  --destructive-foreground: oklch(0.98 0.005 260);
  --border: oklch(0.3 0.014 260);
  --input: oklch(0.28 0.014 260);
  --ring: oklch(0.65 0.22 285 / 0.5);
  --code-bg: oklch(0.14 0.008 260);
  --syntax-tag: oklch(0.8 0.15 20);
  --syntax-attr: oklch(0.85 0.16 95);
  --syntax-string: oklch(0.84 0.16 145);
  --syntax-keyword: oklch(0.78 0.13 300);
  --syntax-comment: oklch(0.55 0.015 260);
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
}

@utility studio-grid {
  background-image:
    linear-gradient(to right, oklch(1 0 0 / 0.035) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(1 0 0 / 0.035) 1px, transparent 1px);
  background-size: 32px 32px;
}

@utility glow-ring {
  box-shadow: var(--shadow-glow);
}

@utility panel-surface {
  background-color: var(--color-panel);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-panel);
}

@utility scroll-slim {
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}

.glass-card {
  background: oklch(0.2 0.01 260 / 0.5);
  backdrop-filter: blur(12px);
  border: 1px solid oklch(0.3 0.01 260 / 0.3);
  border-radius: 12px;
}

.gradient-hero {
  background: radial-gradient(ellipse at top, oklch(0.3 0.05 280 / 0.3), transparent 70%);
}

.hover-glow {
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.hover-glow:hover {
  box-shadow: 0 0 24px oklch(0.6 0.15 280 / 0.4);
  transform: translateY(-2px);
}
/* === Purple Glassmorphism Theme === */

.glass-panel {
  background: rgba(20, 12, 40, 0.5);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(168, 85, 247, 0.15);
  box-shadow:
    0 0 24px rgba(139, 92, 246, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.glass-panel-strong {
  background: rgba(12, 8, 28, 0.7);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(168, 85, 247, 0.2);
}

.purple-glow {
  box-shadow:
    0 0 20px rgba(139, 92, 246, 0.25),
    0 0 40px rgba(168, 85, 247, 0.15);
}

.purple-gradient-bg {
  background:
    radial-gradient(ellipse at top left, rgba(139, 92, 246, 0.15), transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(168, 85, 247, 0.12), transparent 50%),
    #0a0616;
}

.purple-accent {
  background: linear-gradient(135deg, rgb(139, 92, 246) 0%, rgb(168, 85, 247) 100%);
}
