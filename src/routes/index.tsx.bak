                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/telegram/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/react/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/slack/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/vercel/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/kubernetes/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/openai/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
                      <div className="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm"><img src="https://cdn.simpleicons.org/anthropic/ffffff" alt="" className="size-6 opacity-70" loading="lazy" draggable={false} onError={(e) => { (e.currentTarget.parentElement as HTMLElement).style.display = "none"; }} /></div>
