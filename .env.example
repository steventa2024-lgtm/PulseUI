# PulseUI — environment configuration
#
# Copy this file to `.env.local` (ignored by Git) and fill in what you need.
# Every value here is read on the server only. Nothing in this file is sent to
# the browser, and none of it is passed to generated projects.

# ── Application ───────────────────────────────────────────────────────────
# Where PulseUI keeps its SQLite database, project workspaces, version
# history and local deployments. Defaults to ~/.pulseui (outside this repo on
# purpose: generated apps nested inside PulseUI could resolve PulseUI's own
# node_modules and only "work" on this machine).
# PULSEUI_DATA_DIR=

# ── AI providers ──────────────────────────────────────────────────────────
# Configure at least one. The model selector lists only providers that are
# configured here plus local servers (Ollama / LM Studio) that actually answer.

# Preferred provider when several are configured:
#   gemini | openai | openrouter | ollama | lmstudio | local | mock
# (mock = deterministic test provider for CI; never use it for real work)
AI_PROVIDER=
# Default model for AI_PROVIDER.
AI_MODEL=

# Google Gemini — https://aistudio.google.com/apikey (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# Any OpenAI-compatible endpoint (OpenAI, vLLM, a hosted gateway…).
# Requires AI_BASE_URL and AI_MODEL; AI_API_KEY if the endpoint needs one.
AI_BASE_URL=
AI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Local AI (Ollama / LM Studio / llama.cpp) ─────────────────────────────
# Running Ollama or LM Studio on their default ports is detected automatically.
# Set these to pin a specific model or server:
#   Ollama:    LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
#   LM Studio: LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
# A code-tuned model of ~7B+ parameters works best, e.g.
#   ollama pull qwen2.5-coder:7b   →   LOCAL_AI_MODEL=qwen2.5-coder:7b
# When a hosted provider fails before streaming starts, PulseUI falls back to
# the configured local model.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# ── Agent ─────────────────────────────────────────────────────────────────
# Max model ⇄ tool rounds per request, and max automatic build-repair attempts.
# AGENT_MAX_STEPS=16
# AGENT_MAX_REPAIR_ATTEMPTS=3

# ── Commands & preview ────────────────────────────────────────────────────
# Interface the project dev servers bind to, and the host the browser uses to
# reach them (change both when PulseUI runs on another machine).
# PREVIEW_HOST=localhost
# PREVIEW_PUBLIC_HOST=localhost
# PREVIEW_PORT_START=4100
# PREVIEW_PORT_END=4999
# PREVIEW_READY_TIMEOUT_MS=90000
# COMMAND_TIMEOUT_MS=300000
# INSTALL_TIMEOUT_MS=600000

# ── GitHub ────────────────────────────────────────────────────────────────
# Public repositories import without a token. A token enables private imports;
# it is sent as an HTTP header for the clone only and never written to disk.
GITHUB_TOKEN=

# ── Optional service credentials (shown on the Connections page) ──────────
# PulseUI reports whether these are configured. They are never injected into
# generated apps.
SUPABASE_URL=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
