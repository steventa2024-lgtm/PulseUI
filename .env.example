# PromptUI Studio — environment variables
#
# ── IMPORTANT ─────────────────────────────────────────────────────────────
# `.env` is COMMITTED in this repository (it is not covered by .gitignore) and
# syncs back to Lovable and GitHub. Put secrets in `.env.local` instead — that
# file is ignored via the `*.local` rule and is loaded by Bun the same way.
# ──────────────────────────────────────────────────────────────────────────

# ---- AI provider ----------------------------------------------------------
# The studio's model is Gemini 3.7 Flash. Resolution order is:
#   GEMINI_API_KEY  →  LOVABLE_API_KEY  →  ANTHROPIC_API_KEY
# The first key present wins, so a local Gemini key overrides everything else.

# Preferred. Create a key at https://aistudio.google.com/apikey
# Put this in .env.local, NOT in .env.
# GOOGLE_API_KEY is accepted as an alias if you already have one exported.
GEMINI_API_KEY=

# Same Gemini 3.7 Flash model, reached through the Lovable AI gateway. Injected
# automatically inside the Lovable sandbox, so you only need to set this if you
# want the gateway path while developing locally.
LOVABLE_API_KEY=

# Opt-in fallback (Claude). Only used when neither key above is set.
# ANTHROPIC_API_KEY=

# ---- Local model (Ollama / LM Studio / llama.cpp) -------------------------
# Optional, and the reason it exists: hosted tiers run out of quota, a model on
# your own machine does not. When set, the local model is used two ways:
#   1. as the last entry in the provider chain, if no cloud key is present
#   2. as an automatic fallback whenever the cloud provider fails
# There is no default model — guessing one that is not pulled would fail at
# generation time rather than at startup.
#
#   ollama pull qwen2.5-coder:7b
#   LOCAL_AI_MODEL=qwen2.5-coder:7b
#
# Reach for a code-tuned model of at least ~7B. Measured over repeated runs,
# qwen2.5-coder:7b produced valid JSX 8/8 times; a 6.7B coder managed 1/3, and
# small general models (llama3.2:3b, phi3:mini) reliably emit unbalanced JSX.
LOCAL_AI_MODEL=

# Any OpenAI-compatible server. Defaults to Ollama; LM Studio is
# http://localhost:1234/v1.
LOCAL_AI_BASE_URL=

# ---- Supabase (already provisioned by Lovable) ----------------------------
# Present in .env. The publishable key is safe to expose to the browser.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
